{
  "name": "movie-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "predev": "node scripts/prepare-media.mjs",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "prepare:media": "node scripts/prepare-media.mjs",
    "prebuild": "node scripts/prepare-media.mjs",
    "test": "node tests/all.mjs",
    "test:api": "node tests/api.mjs",
    "test:characters": "node tests/characters.mjs",
    "test:plan-sync": "node tests/plan-sync.mjs",
    "test:storyboard-prompt": "node tests/storyboard-image-prompt.mjs",
    "test:voice-workflow": "node tests/voice-workflow.mjs",
    "test:speech-approval": "node tests/speech-approval.mjs",
    "test:character-removal": "node tests/character-removal.mjs",
    "test:openai-image": "node tests/openai-image.mjs",
    "test:speech-modes": "node tests/speech-modes.mjs",
    "test:lipsync": "node tests/lipsync.mjs && node tests/lipsync-image.mjs && node tests/lipsync-media.mjs",
    "test:editing": "node tests/variant-removal.mjs && node tests/selected-speech.mjs",
    "test:uploads": "node tests/asset-uploads.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test:storage": "node tests/storage.mjs",
    "test:auth": "node tests/auth.mjs",
    "test:integration": "node tests/server-smoke.mjs",
    "test:container": "node tests/container-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.5.4",
    "next": "16.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.1"
  }
}
