# Prefer `npm run setup -- --origin=https://studio.example.com --username=director`.
# Setup creates random secrets and prints the login password once.
APP_ORIGIN=http://127.0.0.1:3000
ADMIN_USERNAME=director
# Environment-safe scrypt hash from setup (colon-separated).
ADMIN_PASSWORD_HASH=''
# At least 32 random bytes; changing it invalidates sessions.
SESSION_SECRET=
# Exactly 32 random bytes encoded as base64. Keep it with backups.
VAULT_KEY=
DATA_DIR=./data
HOSTNAME=127.0.0.1
PORT=3000
